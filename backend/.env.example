# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/servora

# Authentication
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# Redis & BullMQ
REDIS_URL=redis://127.0.0.1:6379

# File Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads